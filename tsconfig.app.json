{
  // Дэлгүүрийн хуудасны скрипт: src/client/js/app.ts → public/js/app.js
  "compilerOptions": {
    "target": "es2021",
    "module": "es2022",
    "lib": ["es2021", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "rootDir": "src/client",
    "outDir": "public",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": ["src/client/js/app.ts"]
}
