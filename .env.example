# ---------------------------------------------------------------------------
# Khishgee's Salon — тохиргоо
#
# Энэ файлыг .env нэрээр хуулж, утгуудаа бөглөнө. Хоосон үлдээсэн хэсэг
# "туршилтын горимд" (mock) ажиллана — бүх урсгал бүтэн, зөвхөн гадаад
# үйлчилгээ рүү бодит дуудлага явахгүй.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Сервер
PORT=3000
# Интернэтэд харагдах хаяг — QPay callback ирүүлэхэд шаардлагатай
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------- QPay төлбөр -----------------------------------
# Гурвууланг бөглөвөл live горим. QPay-тэй мерчант гэрээ байгуулахад өгнө.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Туршилтын серверт холбох бол:
# QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2

# ---------------------------- SMS мэдэгдэл ----------------------------------
# mock | http | twilio
SMS_PROVIDER=mock
SMS_FROM=Khishgee
SMS_COUNTRY_CODE=976
SMS_NOTIFY_ON_ORDER=true
SMS_NOTIFY_ON_STATUS=true

# --- http: Монголын оператор / агрегаторын ерөнхий HTTP API ---
# {to} {text} {from} орлуулагчийг ашиглана
# SMS_HTTP_URL=https://api.example.mn/send
# SMS_HTTP_METHOD=GET
# SMS_HTTP_QUERY=key=ТҮЛХҮҮР&from={from}&to={to}&text={text}
# POST бол:
# SMS_HTTP_METHOD=POST
# SMS_HTTP_BODY={"from":"{from}","to":"{to}","text":"{text}"}
# SMS_HTTP_CONTENT_TYPE=application/json
# SMS_HTTP_AUTH_HEADER=Bearer ТҮЛХҮҮР

# --- twilio ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx

# ---------------------------- Зураг байршуулах ------------------------------
UPLOAD_MAX_BYTES=5242880

# ---------------------------- Нууц үг сэргээх -------------------------------
RESET_CODE_TTL_MIN=15
RESET_MAX_ATTEMPTS=5
# SMS mock үед сэргээх кодыг API хариунд буцаах (ЗӨВХӨН хөгжүүлэлтэд).
# SMS live болмогц энэ тохиргоо үл хамааран код хэзээ ч буцахгүй.
RESET_REVEAL_IN_MOCK=true
